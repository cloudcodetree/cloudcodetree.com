{
  "name": "cloudcodetree-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Professional portfolio website for Chris Harper - Full Stack Developer & Cloud Solutions Architect",
  "author": "Chris Harper <chris@cloudcodetree.com>",
  "homepage": "https://cloudcodetree.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudcodetree/cloudcodetree.com.git"
  },
  "keywords": [
    "react",
    "typescript",
    "portfolio",
    "mui",
    "nextjs",
    "cloudcodetree"
  ],
  "scripts": {
    "dev": "node scripts/generate-feeds.mjs && next dev",
    "feeds": "node scripts/generate-feeds.mjs",
    "prebuild": "node scripts/apply-drafts.mjs && node scripts/generate-feeds.mjs",
    "build": "next build",
    "start": "wrangler dev --local",
    "lint": "eslint app worker scripts --ext .js,.mjs,.ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "build:staging": "node scripts/build-staging.mjs",
    "link-projects": "node scripts/link-projects.mjs",
    "deploy:staging": "node scripts/assert-variant.mjs staging && wrangler deploy --env staging",
    "deploy:prod": "node scripts/assert-variant.mjs production && wrangler deploy",
    "dev:turbo": "node scripts/generate-feeds.mjs && next dev --turbo",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm run typecheck:worker && pnpm run lint"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "7.0.0-beta.15",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/system": "^7.3.11",
    "@next/mdx": "^15.5.25",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "autoprefixer": "^10.5.5",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "minisearch": "^7.2.0",
    "next": "^15.5.25",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "fast-xml-parser": "^5.11.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.13.0"
  }
}
