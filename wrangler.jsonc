{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cct-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Matches GitHub Pages' /about -> /about/ redirect; consistent with
    // trailingSlash: true in next.config.js.
    "html_handling": "force-trailing-slash",
    // Serve public/404.html on a miss, as Pages does. The default ("none")
    // would return a bare 404 and break parity.
    "not_found_handling": "404-page",
    // These paths 404 until Phase 2. Declared now so the array form is proven
    // to deploy before anything depends on it. /ai-news/feed.xml is here so the
    // Worker can answer ?topics= — with no parameter it serves the same asset.
    "run_worker_first": ["/api/*", "/projects/*/demo/*", "/admin/*", "/ai-news/feed.xml", "/tutorials/feed.xml"]
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // Search: Workers AI embeds the query, Vectorize holds the post chunks.
  // Both on the Free plan; the index is filled by scripts/index-search.mjs in CI.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "cct-search" }],
  // Engagement (spec 2026-09-24-reader-reactions-design.md): reactions, saves
  // and reads as aggregate events. Staging writes its own dataset below, so
  // beta testing never touches production numbers.
  "analytics_engine_datasets": [{ "binding": "ENGAGEMENT", "dataset": "cct_engagement" }],
  // Spam damping for /api/engage. Per Cloudflare location and approximate by design.
  "ratelimits": [{ "name": "ENGAGE_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } }],
  // The apex flip (cutover runbook step 6): a Worker ROUTE overlays the proxied
  // GitHub Pages A records — no DNS edit, and deleting the route is the rollback.
  // www is deliberately NOT routed: the Worker only runs for run_worker_first
  // paths, so a www route would serve duplicate content instead of GitHub Pages'
  // 301 to the apex. A zone-level Single Redirect rule takes that job (OpenTofu).
  "routes": [
    { "pattern": "cloudcodetree.com/*", "zone_name": "cloudcodetree.com" }
  ],
  "vars": {
    "PRODUCTION_HOSTNAME": "cloudcodetree.com",
    // Origins allowed to call /api/engage*. The 127.0.0.1 entry is the local
    // wrangler dev server the browser tests use.
    "ENGAGE_ORIGINS": "https://cloudcodetree.com,http://127.0.0.1:8788",
    // Filled when the cct-demos Supabase project exists (Phase 2 Task 0).
    // Empty means the gate fails CLOSED (503) — never open.
    "SUPABASE_URL": "https://tgcysgioncdmtzcfknix.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_xElUD5_ZTjOVM8ZHSZ1lQw_Zq5gto2o",
    // The owner's Supabase user id — /admin/* answers only to this account. Not a secret.
    "OWNER_USER_ID": "e57766e4-81ca-438e-bb08-e45735dfda2c"
  },
  "env": {
    "staging": {
      "name": "cct-site-staging",
      // beta.cloudcodetree.com = the persistent real-domain rehearsal alias.
      // Deliberately points at STAGING (noindex build): pre-prod on the real
      // domain without an indexable duplicate of production.
      "routes": [
        { "pattern": "beta.cloudcodetree.com", "custom_domain": true }
      ],
      "vars": {
        "PRODUCTION_HOSTNAME": "cloudcodetree.com",
        "ENGAGE_ORIGINS": "https://beta.cloudcodetree.com,https://cct-site-staging.chris-247.workers.dev",
        "SUPABASE_URL": "https://tgcysgioncdmtzcfknix.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_xElUD5_ZTjOVM8ZHSZ1lQw_Zq5gto2o",
        // The owner's Supabase user id — /admin/* answers only to this account. Not a secret.
        "OWNER_USER_ID": "e57766e4-81ca-438e-bb08-e45735dfda2c"
      },
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/projects/*/demo/*", "/admin/*", "/ai-news/feed.xml", "/tutorials/feed.xml"]
      },
      // Search: Workers AI embeds the query, Vectorize holds the post chunks.
      // Both on the Free plan; the index is filled by scripts/index-search.mjs in CI.
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "cct-search" }],
      "analytics_engine_datasets": [{ "binding": "ENGAGEMENT", "dataset": "cct_engagement_staging" }],
      "ratelimits": [{ "name": "ENGAGE_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }]
    }
  }
}
